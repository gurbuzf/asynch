libasynch.la: $(libasynch_la_OBJECTS) $(libasynch_la_DEPENDENCIES) $(EXTRA_libasynch_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libasynch_la_LINK) -rpath $(libdir) $(libasynch_la_OBJECTS) $(libasynch_la_LIBADD) $(LIBS)

assim$(EXEEXT): $(assim_OBJECTS) $(assim_DEPENDENCIES) $(EXTRA_assim_DEPENDENCIES) 
	@rm -f assim$(EXEEXT)
	$(AM_V_CCLD)$(assim_LINK) $(assim_OBJECTS) $(assim_LDADD) $(LIBS)

asynch$(EXEEXT): $(asynch_OBJECTS) $(asynch_DEPENDENCIES) $(EXTRA_asynch_DEPENDENCIES) 
	@rm -f asynch$(EXEEXT)
	$(AM_V_CCLD)$(asynch_LINK) $(asynch_OBJECTS) $(asynch_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f assim/*.$(OBJEXT)
	-rm -f assim/*.lo
	-rm -f models/*.$(OBJEXT)
	-rm -f models/*.lo
	-rm -f solvers/*.$(OBJEXT)
